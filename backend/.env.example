# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK
# Path to the service-account JSON file (download from Firebase console)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# Google Gemini — powers the AI reasoning layer.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
# Leaving GEMINI_API_KEY empty is fully supported: every AI feature falls back to
# a deterministic path, retrieval ranks lexically, and the platform stays usable.
GEMINI_API_KEY=your-gemini-api-key-here

# Model names change, and a retired one fails as an opaque 404 at request time
# rather than at startup. Two traps worth knowing:
#   - Older Flash models return "no longer available to new users" even though
#     they still show up in list_models().
#   - The "-latest" aliases point at models with no free quota, so they 429
#     straight away. Pin a version on the free tier.
#   - Reasoning models are much slower. gemini-3.6-flash took ~24s on a coach
#     prompt; gemini-3.5-flash answered the same one in ~5.8s. On a path where a
#     learner is waiting, that decides whether the feature is usable.
# Run `python scripts/reindex.py --stats` and check /health after changing this.
GEMINI_MODEL=gemini-3.5-flash

# Embeds knowledge chunks for semantic retrieval. Optional: with no embeddings the
# retriever uses a built-in TF-IDF ranker — no extra dependency, no network call,
# and small enough for a serverless deploy.
# The "models/" prefix is REQUIRED here; without it embed_content() raises and the
# gateway silently falls back to lexical ranking.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# LLM gateway budget and timeouts.
# 5/min is the actual Gemini free-tier ceiling, reported by the API itself as
# GenerateRequestsPerMinutePerProjectPerModel-FreeTier. Setting this higher does
# not buy capacity — it just spends the budget on calls Google rejects instead of
# degrading to our own fallback. Raise it only alongside a paid plan.
LLM_REQUESTS_PER_MINUTE=5
# Interactive paths have a learner waiting; deferred analyses do not. Measured
# round trip is ~5.8s on a coach-sized prompt, so 20s is roughly 3x headroom.
LLM_TIMEOUT_INTERACTIVE_SECONDS=20
LLM_TIMEOUT_DEFERRED_SECONDS=45

# Virtual portfolio
STARTING_CASH=100000

# Price cache (SQLite)
PRICE_DB_PATH=./data/prices.db

# Price refresh (cron)
PRICE_REFRESH_INTERVAL_MINUTES=15
